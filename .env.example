# ══════════════════════════════════════════════════════════════
#  .env.example — Variáveis de Ambiente
#  Copie para .env e preencha os valores REAIS
#  NUNCA commitar o .env no Git!
# ══════════════════════════════════════════════════════════════

# ── Geral ─────────────────────────────────────────────────────
TZ=America/Sao_Paulo                           # Fuso horário do servidor

# ── PostgreSQL ────────────────────────────────────────────────
DB_USER=hauser                                 # Usuário do banco
DB_PASSWORD=TROQUE_POR_SENHA_FORTE             # ← OBRIGATÓRIO mudar!
DB_NAME=homeassistant

# String de conexão completa (usada no configuration.yaml)
# DB_URL=postgresql://hauser:SENHA@localhost/homeassistant

# ── InfluxDB ──────────────────────────────────────────────────
INFLUX_USER=admin
INFLUX_PASSWORD=TROQUE_POR_SENHA_FORTE         # ← OBRIGATÓRIO mudar!
INFLUX_TOKEN=TROQUE_POR_TOKEN_SEGURO           # Token de acesso InfluxDB
INFLUX_ORG=homeassistant
INFLUX_BUCKET=ha_metrics

# ── Grafana ───────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=TROQUE_POR_SENHA_FORTE        # ← OBRIGATÓRIO mudar!
GRAFANA_URL=https://grafana.seudominio.com     # URL pública do Grafana
GRAFANA_DOMAIN=grafana.seudominio.com

# ── Redis ────────────────────────────────────────────────────
REDIS_PASSWORD=TROQUE_POR_SENHA_FORTE          # ← OBRIGATÓRIO mudar!

# ── Home Assistant ────────────────────────────────────────────
HA_DOMAIN=homeassistant.seudominio.com         # Domínio público do HA
HA_SECRET_KEY=TROQUE_POR_CHAVE_SECRETA         # Chave secreta interna

# ── Frigate NVR ───────────────────────────────────────────────
FRIGATE_RTSP_PASSWORD=TROQUE_POR_SENHA         # Senha RTSP stream

# ── APIs externas ────────────────────────────────────────────
ORBE_API_KEY=SUA_CHAVE_API_ORBE               # Chave da API Orbe (lançamentos)

# ── SSL / Let's Encrypt (Coolify/Traefik) ────────────────────
LETSENCRYPT_EMAIL=igordasilvasantos38@gmail.com

# ══════════════════════════════════════════════════════════════
#  COMO GERAR SENHAS SEGURAS:
#  openssl rand -base64 32
#  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
