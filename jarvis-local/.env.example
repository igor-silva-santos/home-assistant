# Copie para .env e preencha (NÃO commitar)

# URL pública do Home Assistant na VPS (HTTPS)
HA_URL=https://homeassistant.seudominio.com

# Token long-lived gerado no perfil do HA (guarde só nesta máquina)
HA_TOKEN=

# Opcional: receber push da VPS (use com Tailscale — IP 100.x.x.x)
JARVIS_LISTEN_HOST=0.0.0.0
JARVIS_LISTEN_PORT=8765
